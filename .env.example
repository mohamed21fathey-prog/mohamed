# متغيرات بيئة MCP Media Generator — انسخها إلى Vercel → Settings → Environment Variables
# أو محليًا في .env.local

# إلزاميان — من حساب Turso:
#   turso db create <name>
#   turso db show <name> --url
#   turso db tokens create <name>
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# إلزامي — رابط خدمة دمج الفيديو المنشورة (مشروع merger في هذا المستودع بعد نشره على Vercel)
MERGER_API_BASE=https://your-merger.vercel.app

# اختياري — إن ضُبط يُطلب Authorization: Bearer <token> على /mcp
MCP_ACCESS_TOKEN=

# اختياري — تجاوز أسماء الموديلات إن لزم
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
